#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 2 || $# -eq 3 ]] || {
    printf 'usage: sudo %s SOURCE_ROOT ANSIBLE_PLAYBOOK [REV]\n' "$0" >&2
    printf 'REV: optional committed ancestor of origin/main to deploy\n' >&2
    printf '     (reviewed-ancestor rollback; DECISION-REVIEWED-ANCESTOR-ROLLBACK-2026-08-24)\n' >&2
    exit 2
}

log=$(mktemp /tmp/workspace-ci-deploy.XXXXXX)
ansible_pid=
tail_pid=
keep_log=false
cleanup() {
    if [[ -n $tail_pid && -d /proc/$tail_pid ]]; then
        if ! kill "$tail_pid"; then
            printf 'warning: could not stop deployment log process %s\n' "$tail_pid" >&2
        fi
        if ! wait "$tail_pid"; then
            printf 'deployment log stopped during cleanup\n' >&2
        fi
    fi
    if [[ -n $ansible_pid && -d /proc/$ansible_pid ]]; then
        if ! kill "$ansible_pid"; then
            printf 'warning: could not stop ansible-playbook process %s\n' "$ansible_pid" >&2
        fi
        if ! wait "$ansible_pid"; then
            printf 'ansible-playbook stopped during cleanup\n' >&2
        fi
    fi
    if [[ $keep_log == false ]]; then
        rm -f "$log"
    fi
}
trap cleanup EXIT

deploy_cmd=("$2" "$1/res/ansible/deploy-ci.yml" -e "source_root=$1" -e "deploy_output=$log")
if [[ $# -eq 3 && -n "$3" ]]; then
    deploy_cmd+=(-e "deploy_rev=$3")
fi

"${deploy_cmd[@]}" & ansible_pid=$!

tail --pid="$ansible_pid" -n +1 -F "$log" &
tail_pid=$!
if wait "$ansible_pid"; then
    status=0
else
    status=$?
fi
ansible_pid=
wait "$tail_pid"
tail_pid=
if [[ $status -ne 0 ]]; then
    keep_log=true
    chown --reference="$1" "$log"
    chmod 0600 "$log"
    printf 'failed deployment log retained at %s\n' "$log" >&2
fi
exit "$status"

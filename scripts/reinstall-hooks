#!/usr/bin/env bash
# reinstall-hooks: regenerate native git hooks.
#
# Hooks are root-owned by design and are only ever written by root
# (deploy-ci, or an operator running `sudo make install-hooks`). There is
# no unseal/re-lock cycle: root-owned hooks are never touched by non-root.
#
# Fast path: no root-owned generated hooks -> plain generate-hooks (fresh
# checkout / agent working repo case).
# Root-owned hooks: refuse unless already running as root; the operator
# reruns via `sudo make install-hooks`.

set -euo pipefail

_CI_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/ci.sh
if ! source "$_CI_ROOT/lib/ci.sh"; then
    echo "ERROR: failed to source $_CI_ROOT/lib/ci.sh" >&2
    exit 1
fi

_GENERATE="${CI_REINSTALL_GENERATE:-$_CI_ROOT/scripts/generate-hooks}"
_MARKER="AUTO-GENERATED by"

# _hooks_root_owned <hooks_dir>: returns 0 if any generated hook is
# root-owned, 1 otherwise.
_hooks_root_owned() {
    local _hooks_dir="$1" _stage _hook _owner
    for _stage in pre-commit commit-msg pre-push; do
        _hook="$_hooks_dir/$_stage"
        [[ -f "$_hook" ]] || continue
        grep -q "$_MARKER" "$_hook" || continue
        if [[ "$(ci_platform_name)" == "darwin" ]]; then
            _owner="$(stat -f '%Su' "$_hook")"
        else
            _owner="$(stat -c '%U' "$_hook")"
        fi
        [[ "$_owner" == "root" ]] && return 0
    done
    return 1
}

main() {
    local _repo_root
    _repo_root="$(git rev-parse --show-toplevel)"

    if _hooks_root_owned "$_repo_root/.git/hooks" && [[ "$(id -u)" -ne 0 ]]; then
        ci_fail "hooks are root-owned; regenerate as root: sudo make -C projects/CI install-hooks CONSUMER=$_repo_root"
        exit 1
    fi

    # Re-exec the generator with the SAME interpreter we are running under:
    # root reaches us via make's SCRIPT_BASH (/bin/bash.real), and a bare
    # `bash` would resolve to the guarded /usr/bin/bash which fails closed
    # for root (AT_SECURE == 0). $BASH always names the running binary.
    "$BASH" "$_GENERATE"
}

main "$@"

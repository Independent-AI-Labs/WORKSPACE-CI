#!/usr/bin/env bash
# reinstall-hooks: regenerate native git hooks.
set -euo pipefail

_SELF="${BASH_SOURCE[0]:-$0}"
case "$_SELF" in /proc/self/fd/*) _SELF="${SHG_SCRIPT_PATH:-$_SELF}" ;; esac
_CI_ROOT="$(cd "$(dirname "$_SELF")/.." && pwd)"
if ! source "$_CI_ROOT/lib/ci.sh"; then
    printf 'reinstall-hooks: failed to load lib/ci.sh\n' >&2
    exit 1
fi

_GENERATE="${CI_REINSTALL_GENERATE:-$_CI_ROOT/scripts/generate-hooks}"
_MARKER="AUTO-GENERATED by"

_hooks_root_owned() {
    local hooks_dir=$1 stage hook owner
    for stage in pre-commit commit-msg pre-push; do
        hook="$hooks_dir/$stage"
        [[ -f "$hook" ]] || continue
        grep -q "$_MARKER" "$hook" || continue
        owner="$(stat -c '%U' "$hook")"
        [[ "$owner" == root ]] && return 0
    done
    return 1
}

main() {
    local repo_root hooks_dir generated stage hook _installed=0
    repo_root="$(git rev-parse --show-toplevel)"
    hooks_dir="$(git -C "$repo_root" rev-parse --git-path hooks)"
    [[ "$hooks_dir" == /* ]] || hooks_dir="$repo_root/$hooks_dir"
    if _hooks_root_owned "$repo_root/.git/hooks" && [[ "$(id -u)" -ne 0 ]]; then
        ci_fail "hooks are root-owned; regenerate as root: sudo make -C $repo_root install-hooks"
        exit 1
    fi
    if [[ "$(id -u)" -ne 0 ]]; then
        "$BASH" "$_GENERATE"
        return
    fi

    ci_acquire_deploy_lock
    generated="$(mktemp -d)"
    trap 'find "$generated" -depth -delete' RETURN
    "$BASH" "$_GENERATE" --output-dir "$generated"
    install -d -o root -g root -m 0755 "$hooks_dir"
    local _installed=0
    for stage in pre-commit commit-msg pre-push; do
        hook="$hooks_dir/$stage"
        [[ -f "$generated/$stage" ]] || { ci_fail "generated hook missing: $stage"; return 1; }
        [[ ! -L "$hook" ]] || { ci_fail "refusing symlink hook: $hook"; return 1; }
        ci_info "installing $stage (root-owned, immutable)"
        [[ ! -e "$hook" ]] || chattr -i -- "$hook"
        install -o root -g root -m 0755 "$generated/$stage" "$hook"
        chattr +i -- "$hook"
        lsattr -d -- "$hook" | awk '{print $1}' | grep -q i || {
            ci_fail "hook is not immutable: $hook"
            return 1
        }
        _installed=$((_installed + 1))
    done
    ci_pass "SUCCESS: $_installed hooks installed to $hooks_dir and verified immutable"
}

main "$@"

#!/usr/bin/env bash
# Install the pinned Rust toolchain into CI's private boot directory.
set -euo pipefail

_SELF="${BASH_SOURCE[0]:-$0}"
case "$_SELF" in /proc/self/fd/*) _SELF="${SHG_SCRIPT_PATH:-$_SELF}" ;; esac
_ci_lib="$(cd "$(dirname "$_SELF")/../lib" && pwd)"
# shellcheck source=lib/ci.sh
if ! source "$_ci_lib/ci.sh"; then
    printf 'bootstrap-rust: failed to source %s\n' "$_ci_lib/ci.sh" >&2
    exit 2
fi

log() { printf '[bootstrap-rust] %s\n' "$*" >&2; }

main() {
    if [[ $EUID -eq 0 ]]; then
        log "refusing to install a downloaded toolchain as root"
        return 1
    fi

    local toolchain rustup_version rustup_sha rust_home target_dir tmp output errors status=0
    toolchain="$(ci_tool_version rust channel)" || return 2
    rustup_version="$(ci_tool_version rustup)" || return 2
    rustup_sha="$(ci_tool_artifact rustup sha256)" || return 2
    rust_home="${CI_PROJECT_ROOT}/${CI_BOOT_NAME}/rust"
    target_dir="${CI_PROJECT_ROOT}/${CI_BOOT_NAME}/bin"
    export RUSTUP_HOME="$rust_home" CARGO_HOME="$rust_home"
    mkdir -p "$rust_home" "$target_dir"

    if [[ ! -x "$rust_home/bin/rustup" ]]; then
        [[ $(uname -s) == Linux && $(uname -m) == x86_64 ]] || {
            log "unsupported rustup platform: $(uname -s)/$(uname -m)"
            return 2
        }
        tmp="$(mktemp -d)"
        trap 'rm -rf "${tmp:-}"' EXIT
        curl -fsSL --retry 3 --retry-delay 2 -o "$tmp/rustup-init" \
            "https://static.rust-lang.org/rustup/archive/$rustup_version/x86_64-unknown-linux-gnu/rustup-init"
        printf '%s  %s\n' "$rustup_sha" "$tmp/rustup-init" | sha256sum -c -
        chmod 0700 "$tmp/rustup-init"
        "$tmp/rustup-init" -y --no-modify-path --default-toolchain none
    fi

    output="$(mktemp)"
    errors="$(mktemp)"
    "$rust_home/bin/rustup" toolchain install "$toolchain" --profile minimal \
        --component clippy,rustfmt,llvm-tools-preview,rust-src >"$output" 2>"$errors" || status=$?
    if [[ $status -ne 0 ]]; then
        log "rustup toolchain install failed (status=$status):"
        cat "$errors" >&2
        rm -f "$output" "$errors"
        return "$status"
    fi
    "$rust_home/bin/rustup" default "$toolchain"
    rm -f "$output" "$errors"

    local binary
    for binary in rustup cargo rustc rustfmt cargo-clippy cargo-fmt clippy-driver rustdoc; do
        if [[ -x "$rust_home/bin/$binary" ]]; then
            ln -sfn "../rust/bin/$binary" "$target_dir/$binary"
        fi
    done
    "$target_dir/rustc" --version
    "$target_dir/cargo" --version
}

main "$@"

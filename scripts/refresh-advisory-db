#!/usr/bin/env bash
# refresh-advisory-db: keep the per-user RustSec advisory database current
# with a full clone, so the offline cargo-deny gate always has a checkout.
#
# cargo-deny stores a database at
#   $db_root/<last-url-segment>-<xxh64-seed-0xca80de71(lowercased url)>
# (advisories/helpers/db.rs url_to_db_path) and reads it offline. It fetches
# databases itself with a shallow `git clone --depth=1`, which the git guard
# rejects: Git spawns its index-pack helper as
# `git --shallow-file <file> index-pack ...` and the guard refuses the
# leading option. This script clones the database in full instead, then
# installs it atomically, leaving any existing checkout untouched when the
# clone fails.
#
# Usage:
#   refresh-advisory-db [--if-stale [HOURS]]
#
# Without --if-stale it always refreshes. With --if-stale it refreshes only
# when the checkout is absent or its newest advisory commit is older than
# HOURS (25 unless overridden), and never fails the caller when the fetch
# cannot reach the network.
#
# Runs as the invoking user and refuses root: the database is per-user
# because the pre-commit gate reads the database owned by the committing
# user.
set -euo pipefail

log() { printf '[refresh-advisory-db] %s\n' "$*" >&2; }

ADVISORY_DB_URL="https://github.com/rustsec/advisory-db"
# cargo-deny's url_to_db_path lowercases the url, hashes it with XxHash64
# seeded with 0xca80de71, and appends the last path segment. For the RustSec
# url the digest is 3157b0e258782691.
ADVISORY_DB_DIR="advisory-db-3157b0e258782691"
DEFAULT_STALE_HOURS=25
FETCH_TIMEOUT_SECONDS=300

usage() {
    cat >&2 <<'EOF'
Usage: refresh-advisory-db [--if-stale [HOURS]]
  --if-stale [HOURS]  refresh only when the checkout is absent or its
                      newest advisory commit is older than HOURS
EOF
}

if_stale=0
stale_hours="$DEFAULT_STALE_HOURS"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --if-stale)
            if_stale=1
            shift
            if [[ $# -gt 0 && "$1" =~ ^[0-9]+$ ]]; then
                stale_hours="$1"
                shift
            fi
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            log "unrecognized argument: $1"
            usage
            exit 2
            ;;
    esac
done

if [[ $EUID -eq 0 ]]; then
    log "refusing to run as root; the advisory database belongs to the user"
    exit 1
fi

# Match cargo-deny's default db-path, ${CARGO_HOME:-$HOME/.cargo}/advisory-dbs,
# so this refresh and the offline `cargo deny` check read the same directory.
db_root="${WORKSPACE_ADVISORY_DB_PATH:-${CARGO_HOME:-$HOME/.cargo}/advisory-dbs}"
checkout="$db_root/$ADVISORY_DB_DIR"
mkdir -p "$db_root"

# newest_commit_epoch <checkout>: print the newest advisory commit time.
newest_commit_epoch() {
    local dir="$1" out
    out="$(mktemp)"
    if ! git -C "$dir" log -1 --format=%ct >"$out" 2>&1; then
        rm -f "$out"
        return 1
    fi
    tr -d '[:space:]' < "$out"
    rm -f "$out"
}

# db_is_fresh: true when the checkout exists with a commit newer than the cutoff.
db_is_fresh() {
    local cutoff epoch
    cutoff=$(( $(date +%s) - stale_hours * 3600 ))
    [[ -d "$checkout/.git" ]] || return 1
    epoch="$(newest_commit_epoch "$checkout")" || return 1
    [[ -n "$epoch" && "$epoch" -ge "$cutoff" ]]
}

# fetch_db: clone the database in full and swap it into place. The live
# checkout is displaced only after a successful clone, so a failed refresh
# never removes a usable database.
fetch_db() {
    local stage repo old
    stage="$(mktemp -d "$db_root/.refresh.XXXXXX")"
    repo="$stage/repo"
    old="$stage/old"
    # Git exports GIT_DIR and friends to hooks; clear them so the clone cannot
    # be redirected into the committing repository.
    if ! env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
           -u GIT_OBJECT_DIRECTORY -u GIT_COMMON_DIR \
           timeout --signal=TERM --kill-after=10s "${FETCH_TIMEOUT_SECONDS}s" \
           git clone --branch main "$ADVISORY_DB_URL" "$repo"; then
        log "advisory database clone failed"
        rm -rf "$stage"
        return 1
    fi
    if [[ ! -d "$repo/crates" ]]; then
        log "cloned advisory database has no crates directory"
        rm -rf "$stage"
        return 1
    fi
    if [[ -e "$checkout" ]]; then
        if ! mv "$checkout" "$old"; then
            log "cannot displace the existing advisory database at $checkout"
            rm -rf "$stage"
            return 1
        fi
    fi
    if ! mv "$repo" "$checkout"; then
        log "cannot install the refreshed advisory database at $checkout"
        if [[ -e "$old" ]]; then
            mv "$old" "$checkout"
        fi
        rm -rf "$stage"
        return 1
    fi
    if ! rm -rf "$stage"; then
        log "kept the previous advisory database backup under $stage"
    fi
    return 0
}

if [[ $if_stale -eq 1 ]]; then
    if db_is_fresh; then
        exit 0
    fi
    if ! fetch_db; then
        log "refresh unavailable; keeping the cached advisory database"
        exit 0
    fi
    exit 0
fi

if ! fetch_db; then
    exit 1
fi
log "advisory database refreshed"

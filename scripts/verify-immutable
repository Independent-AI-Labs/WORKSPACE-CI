#!/usr/bin/env bash
set -euo pipefail

[[ $# -ge 2 && $# -le 3 && -r $1 && $2 =~ ^[0-9]+$ && $2 -ge 1 && $2 -le 32 ]] || {
    printf 'usage: verify-immutable INVENTORY JOBS [SCRIPTS_DIR]\n' >&2
    exit 2
}

inventory=$1
jobs=$2
if [[ $# -eq 3 && -x $3/verify-immutable-batch ]]; then
    script_dir=$3
else
    self=${BASH_SOURCE[0]}
    if resolved=$(readlink -f -- "$self"); then
        self=$resolved
    fi
    script_dir=$(dirname -- "$self")
    if [[ $script_dir == /proc/* ]]; then
        script_dir=${CI_VERIFY_SCRIPT_DIR:-}
    fi
fi
[[ -n $script_dir && -x $script_dir/verify-immutable-batch ]] || {
    printf 'verify-immutable: cannot locate verify-immutable-batch; pass SCRIPTS_DIR or set CI_VERIFY_SCRIPT_DIR\n' >&2
    exit 2
}
total=$(tr -cd '\0' < "$inventory" | wc -c)

xargs -0 -r -n 512 -P "$jobs" "$script_dir/verify-immutable-batch" \
    < "$inventory" \
    | awk -v total="$total" '
        {
            completed += $1
            percent = total == 0 ? 100 : int(completed * 100 / total)
            printf "\rVerifying immutable attributes: %d/%d (%d%%)", completed, total, percent
            fflush()
        }
        END {
            if (total == 0) printf "\rVerifying immutable attributes: 0/0 (100%%)"
            printf "\n"
            if (completed != total) exit 1
        }
    '

#!/usr/bin/env bash
# lock-repo: the SINGLE root-locking pathway for CI repos. Runs as root.
#
# Modes:
#   full (default):   lock a deployment mirror: every git-tracked file,
#                     every tracked parent directory, the repo root dir and
#                     the .git tree become root-owned; exec bits are
#                     restored from the git index; a final integrity gate
#                     verifies ownership, exec bits and (with --branch)
#                     HEAD == origin/<branch>. Used by deploy-ci for
#                     projects/CI.
#   --config-only:    lock the policy catalogs of a working repo:
#                     config/*.yaml and the config/ directory become
#                     root-owned so the agent cannot weaken its own
#                     gates; source code and runtime trees stay
#                     agent-writable. Used by `make lock-repo` and by
#                     deploy-ci as its final step for the work repo.
#
# No seal/unseal cycle exists: root-owned files are only ever written by
# root, so chown alone is the complete invariant. Idempotent.
#
# Usage:
#   lock-repo [--branch <name>] <repo-dir>
#   lock-repo --config-only <repo-dir>
set -euo pipefail

log_info() { printf '\033[0;32m[INFO]\033[0m %s\n' "$*"; }
log_warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$*"; }
log_error() { printf '\033[0;31m[ERROR]\033[0m %s\n' "$*" >&2; }

if [[ $EUID -ne 0 ]]; then
    log_error "lock-repo must run as root"
    exit 1
fi

_CONFIG_ONLY=0
_BRANCH=""
_REPO=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --config-only) _CONFIG_ONLY=1; shift ;;
        --branch) _BRANCH="${2:?--branch needs a value}"; shift 2 ;;
        --*) log_error "unknown flag: $1"; exit 1 ;;
        *)
            if [[ -n "$_REPO" ]]; then
                log_error "unexpected extra argument: $1"
                exit 1
            fi
            _REPO="$1"; shift ;;
    esac
done
if [[ -z "$_REPO" || ! -d "$_REPO/.git" ]]; then
    log_error "usage: lock-repo [--config-only] [--branch <name>] <repo-dir>"
    exit 1
fi
if [[ "$_CONFIG_ONLY" -eq 1 && -n "$_BRANCH" ]]; then
    log_error "--branch is meaningless with --config-only"
    exit 1
fi

# Root-side git reads repos whose .git may be agent- or root-owned; pin
# safe.directory explicitly instead of relying on ambient gitconfig.
git_as_root() {
    env GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0='*' \
        git "$@"
}

# --- --config-only: lock the work repo's policy catalogs -------------------
# Threat model: catalogs (banned words, swallow patterns, thresholds, ...)
# ARE the gates; agent-owned catalogs let the agent weaken its own gates.
# The config dir itself is locked too: an agent-owned dir would allow
# rename-swapping "locked" files (same class as audit C2).
if [[ "$_CONFIG_ONLY" -eq 1 ]]; then
    _cfg_dir="$_REPO/config"
    if [[ ! -d "$_cfg_dir" ]]; then
        log_error "no config/ directory in $_REPO"
        exit 1
    fi
    _count=0
    _fail=0
    for _f in "$_cfg_dir"/*.yaml; do
        [[ -e "$_f" ]] || continue
        if [[ -L "$_f" || ! -f "$_f" ]]; then
            log_error "config entry is not a regular file: $_f"
            _fail=1
            continue
        fi
        chown root:root "$_f"
        _count=$((_count + 1))
    done
    if [[ "$_count" -eq 0 ]]; then
        log_error "no config/*.yaml files found in $_REPO"
        exit 1
    fi
    chown root:root "$_cfg_dir"
    chmod 0755 "$_cfg_dir"
    [[ "$_fail" -eq 0 ]] || { log_error "config lock failed"; exit 1; }
    # Verify fail-closed.
    for _f in "$_cfg_dir"/*.yaml; do
        [[ -e "$_f" ]] || continue
        [[ "$(stat -c '%u' "$_f")" == "0" ]] || { log_error "verify: not root-owned: $_f"; _fail=1; }
    done
    [[ "$(stat -c '%u' "$_cfg_dir")" == "0" ]] || { log_error "verify: config dir not root-owned"; _fail=1; }
    [[ "$_fail" -eq 0 ]] || { log_error "config lock verification failed"; exit 1; }
    log_info "locked $_count config catalogs + config/ dir to root:root in $_REPO"
    exit 0
fi

# --- full: lock a deployment mirror ----------------------------------------

# 1. Lock every git-tracked file to root. Untracked runtime trees are
#    deliberately skipped (see deploy-ci header).
_count=0
_ls_tmp="$(mktemp)" || { log_error "mktemp failed"; exit 1; }
git_as_root -C "$_REPO" ls-files -z > "$_ls_tmp"
while IFS= read -r -d '' f; do
    [[ -e "$_REPO/$f" && ! -L "$_REPO/$f" ]] || continue
    chown root:root "$_REPO/$f"
    _count=$((_count + 1))
done < "$_ls_tmp"
rm -f "$_ls_tmp"
chown root:root "$_REPO"
log_info "locked $_count tracked files to root:root"

# 2. Lock every directory containing tracked files. Without this the dirs
#    stay agent-owned and the agent can rename-swap any "locked" file
#    between deploys (audit C2).
_dir_count=0
_dirs_tmp="$(mktemp)" || { log_error "mktemp failed"; exit 1; }
git_as_root -C "$_REPO" ls-files -z | xargs -0 dirname -z | sort -zu | \
    awk 'BEGIN{RS="\0";ORS="\0"} {p=$0; while (p != "." && p != "") {print p; if (p !~ /\//) break; sub("/[^/]*$", "", p)} print "."}' | sort -zu > "$_dirs_tmp"
while IFS= read -r -d '' _d; do
    chown root:root "$_REPO/$_d"
    chmod 0755 "$_REPO/$_d"
    _dir_count=$((_dir_count + 1))
done < "$_dirs_tmp"
log_info "locked $_dir_count tracked parent directories to root:root"

# 3. Root-own the .git tree so the agent cannot retarget refs/config.
chown -R root:root "$_REPO/.git"
log_info "locked .git to root:root"

# 4. Enforce executable bits from the git index. chown preserves modes,
#    but a file that ever lost +x locally would deploy a hook git does
#    not flag; the index mode (100755) is the source of truth.
_exec_fixed=0
_lss_tmp="$(mktemp)" || { log_error "mktemp failed"; exit 1; }
git_as_root -C "$_REPO" ls-files -s -z > "$_lss_tmp"
while IFS= read -r -d '' _entry; do
    _mode="${_entry%% *}"
    _f="${_entry#*$'\t'}"
    [[ "$_mode" == "100755" && -f "$_REPO/$_f" && ! -x "$_REPO/$_f" ]] || continue
    chmod 0755 "$_REPO/$_f"
    _exec_fixed=$((_exec_fixed + 1))
done < "$_lss_tmp"
[[ "$_exec_fixed" -gt 0 ]] && log_warn "restored exec bit on $_exec_fixed file(s) from index modes"

# 5. Final integrity gate: the deployment must verify clean before any
#    consumer commit/push is allowed against it (guard ci_integrity).
_verify_fail=0
while IFS= read -r -d '' _entry; do
    _mode="${_entry%% *}"
    _f="${_entry#*$'\t'}"
    _p="$_REPO/$_f"
    [[ -e "$_p" || -L "$_p" ]] || { log_error "verify: tracked file missing: $_f"; _verify_fail=1; continue; }
    [[ -L "$_p" ]] && continue
    _owner="$(stat -c '%u' "$_p")"
    [[ "$_owner" == "0" ]] || { log_error "verify: not root-owned: $_f (uid $_owner)"; _verify_fail=1; }
    if [[ "$_mode" == "100755" && ! -x "$_p" ]]; then
        log_error "verify: index 100755 but not executable: $_f"
        _verify_fail=1
    fi
done < "$_lss_tmp"
rm -f "$_lss_tmp"
while IFS= read -r -d '' _d; do
    [[ "$(stat -c '%u' "$_REPO/$_d")" == "0" ]] || { log_error "verify: dir not root-owned: $_d"; _verify_fail=1; }
done < "$_dirs_tmp"
rm -f "$_dirs_tmp"
[[ "$(stat -c '%u' "$_REPO/.git")" == "0" ]] || { log_error "verify: .git not root-owned"; _verify_fail=1; }
if [[ -n "$_BRANCH" ]]; then
    _head="$(git_as_root -C "$_REPO" rev-parse HEAD)"
    _origin="$(git_as_root -C "$_REPO" rev-parse refs/remotes/origin/"$_BRANCH")"
    [[ "$_head" == "$_origin" ]] || { log_error "verify: HEAD != origin/$_BRANCH"; _verify_fail=1; }
fi
if [[ "$_verify_fail" -ne 0 ]]; then
    log_error "integrity verification failed for $_REPO"
    exit 1
fi
log_info "integrity verification passed"

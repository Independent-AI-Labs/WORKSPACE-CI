#!/usr/bin/env bash
set -euo pipefail

[[ $# -gt 0 ]] || exit 0

if lsattr -d -- "$@" | awk -v expected="$#" '
    /^[[:alpha:]-]+[[:space:]]/ {
        seen++
        if (index($1, "i") == 0) bad = 1
    }
    END { exit bad || seen != expected }
'; then
    printf '%d\n' "$#"
    exit 0
fi

for path in "$@"; do
    if ! attributes=$(lsattr -d -- "$path"); then
        printf 'immutable verification failed: %q: lsattr failed\n' "$path" >&2
    elif [[ ${attributes%%[[:space:]]*} != *i* ]]; then
        printf 'immutable verification failed: %q: immutable flag missing\n' "$path" >&2
    fi
done
exit 1

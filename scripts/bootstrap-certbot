#!/usr/bin/env bash
# bootstrap-certbot: install certbot + certbot-dns-cloudflare into the boot bin dir.
#
# Uses `uv tool install` with UV_TOOL_BIN_DIR pointing at
# $CI_PROJECT_ROOT/$CI_BOOT_NAME/bin/ (same layout as bootstrap-ansible).
#
# CI_PROJECT_ROOT is set by lib/ci.sh.

set -euo pipefail

_SELF="${BASH_SOURCE[0]:-$0}"
case "$_SELF" in /proc/self/fd/*) _SELF="${SHG_SCRIPT_PATH:-$_SELF}" ;; esac
_ci_lib="$(cd "$(dirname "$_SELF")/../lib" && pwd)"
# shellcheck source=lib/ci.sh
if ! source "$_ci_lib/ci.sh"; then
    echo "ERROR: failed to source $_ci_lib/ci.sh" >&2
    exit 2
fi
if [[ -z "${CI_PROJECT_ROOT:-}" ]]; then
    echo "ERROR: CI_PROJECT_ROOT not set after sourcing ci.sh" >&2
    exit 2
fi

_log() { printf '[bootstrap-certbot] %s\n' "$*" >&2; }

main() {
    local target_dir tool_dir python_dir uv_bin boot_bin
    boot_bin="${CI_PROJECT_ROOT}/${CI_BOOT_NAME}/bin"
    # Containment: everything lives inside the boot dir. A root-locked boot
    # bin is not a reason to escape to .local -- it means the operator must
    # run this with elevation. Boot dir only, by design.
    target_dir="${UV_TOOL_BIN_DIR:-${boot_bin}}"
    tool_dir="${UV_TOOL_DIR:-${CI_PROJECT_ROOT}/${CI_BOOT_NAME}/uv-tools}"
    python_dir="${UV_PYTHON_INSTALL_DIR:-${CI_PROJECT_ROOT}/${CI_BOOT_NAME}/python}"
    uv_bin="${boot_bin}/uv"

    if [[ ! -x "$uv_bin" ]]; then
        _log "ERROR: uv not found at $uv_bin -- run 'make install-boot-tools' first"
        return 1
    fi

    if [[ ! -w "$target_dir" ]]; then
        _log "ERROR: $target_dir not writable -- boot dir is root-locked; run elevated: sudo make install-certbot"
        return 1
    fi

    if [[ -x "$target_dir/certbot" ]]; then
        local v v_rc=0
        v="$("$target_dir/certbot" --version 2>&1)" || v_rc=$?
        if [[ "$v_rc" -eq 0 ]]; then
            v="${v%%$'\n'*}"
            _log "certbot already installed: $v"
            return 0
        fi
        _log "existing certbot at $target_dir is broken; re-installing"
    fi

    _log "installing certbot + certbot-dns-cloudflare via uv tool..."
    if ! mkdir -p "$target_dir"; then
        _log "mkdir failed for $target_dir"
        return 1
    fi

    UV_PYTHON_INSTALL_DIR="$python_dir" UV_TOOL_DIR="$tool_dir" UV_TOOL_BIN_DIR="$target_dir" \
        "$uv_bin" tool install certbot --with certbot-dns-cloudflare --force

    local v_out v_rc=0
    v_out="$("$target_dir/certbot" --version 2>&1)" || v_rc=$?
    if [[ "$v_rc" -ne 0 ]]; then
        _log "post-install verification failed: certbot --version returned status=$v_rc"
        _log "$v_out"
        return 1
    fi
    _log "installed: ${v_out%%$'\n'*} => $target_dir/certbot"
}

main "$@"
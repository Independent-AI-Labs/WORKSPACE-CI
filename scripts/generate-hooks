#!/usr/bin/env bash
# generate-hooks: Generate native git hooks from .pre-commit-config.yaml.
set -euo pipefail

_SELF="${BASH_SOURCE[0]:-$0}"
case "$_SELF" in /proc/self/fd/*) _SELF="${SHG_SCRIPT_PATH:-$_SELF}" ;; esac
_SCRIPT_DIR="$(cd "$(dirname "$_SELF")" && pwd)"
_CI_ROOT="$(cd "$_SCRIPT_DIR/.." && pwd)"
if ! source "$_CI_ROOT/lib/ci.sh"; then
    printf 'generate-hooks: failed to load lib/ci.sh\n' >&2
    exit 1
fi
if ! source "$_CI_ROOT/lib/checks_quality.sh"; then
    printf 'generate-hooks: failed to load lib/checks_quality.sh\n' >&2
    exit 1
fi

_config=".pre-commit-config.yaml"
_output_dir=""
_dry_run=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --config) _config="$2"; shift 2 ;;
        --output-dir) _output_dir="$2"; shift 2 ;;
        --dry-run) _dry_run=1; shift ;;
        *) ci_fail "Unknown option: $1"; exit 1 ;;
    esac
done
[[ -f "$_config" ]] || { ci_fail "Config not found: $_config"; exit 1; }
[[ -n "$_output_dir" ]] || _output_dir="$(git rev-parse --git-dir)/hooks"
mkdir -p "$_output_dir"
ci_info "generate-hooks: $_config -> $_output_dir"

_hooks="$(awk -f "$_CI_ROOT/lib/parse_precommit_config.awk" "$_config")"
if [[ -z "$_hooks" ]]; then
    ci_pass "no hooks configured; nothing to generate"
    exit 0
fi
_total_entries="$(printf '%s\n' "$_hooks" | awk 'END {print NR}')"
ci_pass "parsed $_total_entries hook entries from $_config"

# === entry-resolution integrity (2026-08-24 portable_shell incident) ===
# A rendered hook whose entry does not resolve fails only at commit time,
# in the deployed artifact, where fixing it deadlocks (the broken gate
# blocks the fix commit). Refuse at generation instead: every shell
# function entry must be defined in the sourced lib, and every python
# module entry must exist as a file. This mirrors what the hook itself
# will do: source lib/checks.sh, then invoke the entry.
_entry_unresolved=0
_written_stages=()
while IFS=$'\034' read -r _e_id _e_name _e_entry _e_rest; do
    [[ -n "$_e_id" ]] || continue
    # grep exits 1 when an entry has no shell-function token (make
    # targets, python modules, bare commands); that is expected.
    _e_fns=""
    _e_fns_rc=0
    _e_fns="$(printf '%s\n' "$_e_entry" | grep -oE 'ci_[a-z_][a-z0-9_]*' | sort -u)" || _e_fns_rc=$?
    for _e_fn in $_e_fns; do
        _e_found=""
        for _e_lib in "$_CI_ROOT"/lib/*.sh; do
            if grep -qE "^[[:space:]]*(function[[:space:]]+)?${_e_fn}[[:space:]]*\(\)" "$_e_lib"; then
                _e_found="$_e_lib"
                break
            fi
        done
        if [[ -z "$_e_found" ]]; then
            ci_fail "Hook '$_e_id' entry references '${_e_fn}' but no lib module defines it."
            echo "  Checked: $_CI_ROOT/lib/*.sh" >&2
            _entry_unresolved=1
        fi
    done
    _e_mod=""
    _e_mod_rc=0
    _e_mod="$(printf '%s\n' "$_e_entry" | grep -oE 'python -m ci\.[a-z_][a-z0-9_.]*' | sed 's/^python -m //')" || _e_mod_rc=$?
    _e_mod="${_e_mod%%$'\n'*}"
    _e_mod_path="${_e_mod//./\/}"
    if [[ -n "$_e_mod" && ! -f "$_CI_ROOT/$_e_mod_path.py" && ! -d "$_CI_ROOT/$_e_mod_path" ]]; then
        ci_fail "Hook '$_e_id' entry references python module '$_e_mod' but it does not exist."
        _entry_unresolved=1
    fi
done <<< "$_hooks"
[[ $_entry_unresolved -eq 0 ]] || exit 1
ci_pass "entry integrity: all shell functions and python modules resolve in lib"

for _stage in pre-commit commit-msg pre-push; do
    _stage_hooks="$(printf '%s\n' "$_hooks" | awk -F'\034' -v s="$_stage" '$4 == s')"
    [[ -n "$_stage_hooks" ]] || continue
    # grep -c exits 1 on zero matches and awk can legitimately emit
    # nothing (stage with no advisory hooks); both are fatal under
    # set -e inside $( ). Count with awk's END block instead: always
    # prints, always exits 0.
    _stage_count="$(printf '%s\n' "$_stage_hooks" | awk 'END {print NR}')"
    _stage_advisory="$(printf '%s\n' "$_hooks" | awk -F'\034' -v s="$_stage" '$4 == s && $11 == "true"' | awk 'END {print NR}')"
    _tmp="$(mktemp)"
    {
        printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail'
        printf '%s\n' '# AUTO-GENERATED by /opt/workspace-ci/scripts/generate-hooks'
        printf '_ROOT="$(git rev-parse --show-toplevel)"\ncd "$_ROOT"\n'
        printf '%s\n' '[[ -f /opt/workspace-ci/lib/ci.sh ]] || { printf "WORKSPACE-CI deployment unavailable\\n" >&2; exit 1; }'
        printf '%s\n' 'source /opt/workspace-ci/lib/ci.sh'
        printf '%s\n' ''
        printf '%s\n' '# === quality_exceptions.yaml preflight (mandatory) ==='
        printf '%s\n' 'if [[ ! -f "$_ROOT/quality_exceptions.yaml" ]]; then'
        printf '%s\n' '    ci_fail "quality_exceptions.yaml missing at $_ROOT"'
        printf '%s\n' '    echo "  Fix: copy /opt/workspace-ci/templates/quality_exceptions.template.yaml"'
        printf '%s\n' '    echo "       to $_ROOT/quality_exceptions.yaml and replace __PROJECT_NAME__."'
        printf '%s\n' '    exit 1'
        printf '%s\n' 'fi'
        printf '%s\n' ''
        printf '%s\n' '# === exemption-file compliance (mandatory) ==='
        printf '%s\n' '# CI-BUILTIN-EXEMPTION-COMPLIANCE'
        printf '%s\n' '_exemptions_lib="/opt/workspace-ci/lib/ci_exemptions.sh"'
        printf '%s\n' '_exemptions_manifest="/opt/workspace-ci/config/exemption_files.yaml"'
        printf '%s\n' 'if [[ ! -f "$_exemptions_lib" || ! -f "$_exemptions_manifest" ]]; then'
        printf '%s\n' '    ci_fail "CI exemption infrastructure missing (lib/ci_exemptions.sh or config/exemption_files.yaml)"'
        printf '%s\n' '    exit 1'
        printf '%s\n' 'fi'
        printf '%s\n' 'if ! source "$_exemptions_lib"; then'
        printf '%s\n' '    ci_fail "failed to source $_exemptions_lib"'
        printf '%s\n' '    exit 1'
        printf '%s\n' 'fi'
        printf '%s\n' '_exemption_fail=0'
        printf '%s\n' '_exemption_paths="$(sed -n "s/^  - path: //p" "$_exemptions_manifest")"'
        printf '%s\n' 'for _rel in $_exemption_paths; do'
        printf '%s\n' '    _exemption_state="$(ci_exemption_file_state "$_ROOT/$_rel")"'
        printf '%s\n' '    if [[ "$_exemption_state" != "ok" ]]; then'
        printf '%s\n' '        ci_fail "exemption file not compliant: $_rel (state: $_exemption_state)"'
        printf '%s\n' '        _exemption_fail=1'
        printf '%s\n' '    fi'
        printf '%s\n' 'done'
        printf '%s\n' 'if [[ "$_exemption_fail" -eq 1 ]]; then'
        printf '%s\n' '    echo "  Fix: files must be root-owned regular files; edit via the root-gated yaml editor"'
        printf '%s\n' '    exit 1'
        printf '%s\n' 'fi'
        printf '%s\n' ''
        printf '%s\n' '# === CI catalog provenance (CI repo only, mandatory) ==='
        printf '%s\n' '# CI-BUILTIN-CATALOG-PROVENANCE'
        printf '%s\n' 'if [[ -f "$_ROOT/scripts/generate-hooks" && -d "$_ROOT/config" ]]; then'
        printf '%s\n' '    _catalog_fail=0'
        printf '%s\n' '    for _catalog in "$_ROOT"/config/*.yaml; do'
        printf '%s\n' '        [[ -e "$_catalog" ]] || continue'
        printf '%s\n' '        _catalog_state="$(ci_exemption_file_state "$_catalog")"'
        printf '%s\n' '        if [[ "$_catalog_state" != "ok" ]]; then'
        printf '%s\n' '            ci_fail "CI catalog not compliant: ${_catalog#$_ROOT/} (state: $_catalog_state)"'
        printf '%s\n' '            _catalog_fail=1'
        printf '%s\n' '        fi'
        printf '%s\n' '    done'
        printf '%s\n' '    if [[ "$_catalog_fail" -eq 1 ]]; then'
        printf '%s\n' '        echo "  Fix: config/*.yaml must be root-owned regular files; edit via the root-gated yaml editor"'
        printf '%s\n' '        exit 1'
        printf '%s\n' '    fi'
        printf '%s\n' 'fi'
        while IFS=$'\034' read -r h_id h_name h_entry h_stage h_pass h_always h_files h_exclude h_args h_types h_advisory; do
            [[ -n "$h_id" ]] || continue
            [[ -n "$h_entry" ]] || { ci_fail "Hook '$h_id' has empty entry"; exit 1; }
            h_cmd="${h_entry//bash -c/\"\$BASH\" -c}"
            h_cmd="${h_cmd//uv run python -m ci./\/opt\/workspace-ci\/.boot-linux\/bin\/uv run --project \/opt\/workspace-ci --no-sync python -m ci.}"
            [[ -n "$h_args" ]] && h_cmd="$h_cmd $h_args"
            printf '# === Hook: %s ===\n' "$h_id"
            printf 'ci_info "Running: %s..."\n' "$h_name"
            if [[ "$h_advisory" == "true" ]]; then
                # Advisory hooks report findings but never fail the gate:
                # the exit status is captured explicitly (sanctioned
                # pattern) and surfaced with ci_info, never enforced.
                printf '_advisory_rc=0\n'
                printf '%s || _advisory_rc=$?\n' "$h_cmd"
                printf 'if [[ "$_advisory_rc" -ne 0 ]]; then ci_info "ADVISORY (non-blocking): %s exited $_advisory_rc; reported, not enforced"; fi\n' "$h_name"
            elif [[ "$_stage" == commit-msg ]]; then
                printf '%s "$1" || { ci_fail "%s"; exit 1; }\n' "$h_cmd" "$h_name"
            else
                printf '%s || { ci_fail "%s"; exit 1; }\n' "$h_cmd" "$h_name"
            fi
        done <<< "$_stage_hooks"
    } > "$_tmp"
    if [[ "$_dry_run" -eq 1 ]]; then
        cat "$_tmp"
        rm -f "$_tmp"
        ci_info "DRY-RUN: $_stage would write $_stage_count hooks ($_stage_advisory advisory)"
    else
        mv "$_tmp" "$_output_dir/$_stage"
        chmod 0755 "$_output_dir/$_stage"
        ci_pass "$_stage: $_stage_count hooks written ($_stage_advisory advisory)"
        _written_stages+=("$_stage")
    fi
done
if [[ "$_dry_run" -eq 1 ]]; then
    ci_pass "dry run complete; no files written"
elif [[ "${#_written_stages[@]}" -gt 0 ]]; then
    ci_pass "SUCCESS: ${#_written_stages[@]} hook files written to $_output_dir"
    ci_info "activate with: make install-hooks"
else
    ci_fail "no stages rendered from $_config"
    exit 1
fi

#!/usr/bin/env bash
# generate-hooks: Generate native git hooks from .pre-commit-config.yaml.
set -euo pipefail

_SELF="${BASH_SOURCE[0]:-$0}"
case "$_SELF" in /proc/self/fd/*) _SELF="${SHG_SCRIPT_PATH:-$_SELF}" ;; esac
_SCRIPT_DIR="$(cd "$(dirname "$_SELF")" && pwd)"
_CI_ROOT="$(cd "$_SCRIPT_DIR/.." && pwd)"
if ! source "$_CI_ROOT/lib/ci.sh"; then
    printf 'generate-hooks: failed to load lib/ci.sh\n' >&2
    exit 1
fi
if ! source "$_CI_ROOT/lib/checks_quality.sh"; then
    printf 'generate-hooks: failed to load lib/checks_quality.sh\n' >&2
    exit 1
fi

_config=".pre-commit-config.yaml"
_output_dir=""
_dry_run=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --config) _config="$2"; shift 2 ;;
        --output-dir) _output_dir="$2"; shift 2 ;;
        --dry-run) _dry_run=1; shift ;;
        *) ci_fail "Unknown option: $1"; exit 1 ;;
    esac
done
[[ -f "$_config" ]] || { ci_fail "Config not found: $_config"; exit 1; }
[[ -n "$_output_dir" ]] || _output_dir="$(git rev-parse --git-dir)/hooks"
mkdir -p "$_output_dir"
ci_info "generate-hooks: $_config -> $_output_dir"

_hooks="$(awk -f "$_CI_ROOT/lib/parse_precommit_config.awk" "$_config")"
if [[ -z "$_hooks" ]]; then
    ci_pass "no hooks configured; nothing to generate"
    exit 0
fi
_total_entries="$(printf '%s\n' "$_hooks" | awk 'END {print NR}')"
ci_pass "parsed $_total_entries hook entries from $_config"

# === registry-driven rendering (single source of truth) ===
# .pre-commit-config.yaml supplies stage membership, order, name, and the
# mutable pass-through fields. Registered shell hooks render from
# config/required_hooks.yaml, so a stale or inline entry in a consumer config
# cannot reintroduce an interpreter wrapper. Custom entries remain verbatim
# and are validated below.
_lib_defines() {
    local _fn="$1" _lib
    for _lib in "$_CI_ROOT"/lib/*.sh; do
        if grep -qE "^[[:space:]]*(function[[:space:]]+)?${_fn}[[:space:]]*\(\)" "$_lib"; then
            return 0
        fi
    done
    return 1
}

_is_interpreter() {
    local _name="$1" _candidate
    case "$_name" in
        python*) return 0 ;;
    esac
    for _candidate in bash sh dash zsh ksh perl ruby node php lua awk; do
        [[ "$_name" == "$_candidate" ]] && return 0
    done
    return 1
}

_reject_inline() {
    local _cmd="$1" _id="$2" _i _prev
    local -a _tokens=()
    read -r -a _tokens <<< "$_cmd"
    for ((_i = 1; _i < ${#_tokens[@]}; _i++)); do
        _prev="${_tokens[_i-1]##*/}"
        _is_interpreter "$_prev" || continue
        case "${_tokens[_i]}" in
            -c|-e)
                ci_fail "Hook '$_id' renders an inline interpreter form; use the sealed runner or a module."
                return 1 ;;
        esac
    done
    return 0
}

_registry_file="$_CI_ROOT/config/required_hooks.yaml"
[[ -f "$_registry_file" ]] || { ci_fail "config/required_hooks.yaml not found"; exit 1; }
declare -A _reg_kind=() _reg_entry=() _reg_args=()
_reg_stream="$(awk -v mode=registry -f "$_CI_ROOT/lib/parse_hook_yaml.awk" "$_registry_file")" || {
    ci_fail "failed to parse config/required_hooks.yaml"
    exit 1
}
while IFS=$'\034' read -r _ri _rk _re _rstage _rpass _ralways _rmand _rsafety _rapp _rfiles _rargs; do
    [[ -n "$_ri" ]] || continue
    _reg_kind["$_ri"]="$_rk"
    _reg_entry["$_ri"]="$_re"
    _reg_args["$_ri"]="$_rargs"
done <<< "$_reg_stream"

_entry_unresolved=0
_resolved_hooks=""
while IFS=$'\034' read -r _h_id _h_name _h_entry _h_stage _h_pass _h_always _h_files _h_exclude _h_args _h_types _h_advisory; do
    [[ -n "$_h_id" ]] || continue
    _kind="${_reg_kind[$_h_id]:-}"
    if [[ -n "$_kind" ]]; then
        case "$_kind" in
            shell|shell_with_arg)
                _fn="${_reg_entry[$_h_id]}"
                [[ -n "$_fn" ]] || { ci_fail "Hook '$_h_id' has an empty registry entry"; _entry_unresolved=1; continue; }
                _h_entry="/opt/workspace-ci/scripts/run-hook ${_fn}"
                [[ -n "${_reg_args[$_h_id]:-}" ]] && _h_entry+=" ${_reg_args[$_h_id]}"
                _h_args=""
                ;;
            python_module|makefile_target)
                ;;
            shell_inline)
                ci_fail "Hook '$_h_id' uses removed kind shell_inline; no inline command is executed."
                _entry_unresolved=1
                continue
                ;;
            *)
                ci_fail "Hook '$_h_id' has unknown kind '$_kind'."
                _entry_unresolved=1
                continue
                ;;
        esac
    fi
    if [[ -n "$_h_args" ]]; then
        _h_entry+=" $_h_args"
        _h_args=""
    fi
    if [[ "$_h_entry" == *'"$@'* ]]; then
        ci_fail "Hook '$_h_id' entry passes filenames (\"\$@\"), which is prohibited; the check must discover the full tree."
        _entry_unresolved=1
    fi
    _reject_inline "$_h_entry" "$_h_id" || _entry_unresolved=1
    _e_fns="$(printf '%s\n' "$_h_entry" | grep -oE 'ci_[a-z_][a-z0-9_]*' | sort -u)" || _e_fns=""
    for _e_fn in $_e_fns; do
        if ! _lib_defines "$_e_fn"; then
            ci_fail "Hook '$_h_id' entry references '${_e_fn}' but no lib module defines it."
            echo "  Checked: $_CI_ROOT/lib/*.sh" >&2
            _entry_unresolved=1
        fi
    done
    _e_mod=""
    _e_mod="$(printf '%s\n' "$_h_entry" | grep -oE 'python -m ci\.[a-z_][a-z0-9_.]*' | sed 's/^python -m //')" || _e_mod=""
    _e_mod="${_e_mod%%$'\n'*}"
    _e_mod_path="${_e_mod//./\/}"
    if [[ -n "$_e_mod" && ! -f "$_CI_ROOT/$_e_mod_path.py" && ! -d "$_CI_ROOT/$_e_mod_path" ]]; then
        ci_fail "Hook '$_h_id' entry references python-module '$_e_mod' but it does not exist."
        _entry_unresolved=1
    fi
    _resolved_hooks+="${_h_id}"$'\034'"${_h_name}"$'\034'"${_h_entry}"$'\034'"${_h_stage}"$'\034'"${_h_pass}"$'\034'"${_h_always}"$'\034'"${_h_files}"$'\034'"${_h_exclude}"$'\034'"${_h_types}"$'\034'"${_h_advisory}"$'\n'
done <<< "$_hooks"
_hooks="$_resolved_hooks"
[[ $_entry_unresolved -eq 0 ]] || exit 1
ci_pass "entry integrity: all shell functions and python-modules resolve in lib"
_written_stages=()

for _stage in pre-commit commit-msg pre-push; do
    _stage_hooks="$(printf '%s\n' "$_hooks" | awk -F'\034' -v s="$_stage" '$4 == s')"
    [[ -n "$_stage_hooks" ]] || continue
    # grep -c exits 1 on zero matches and awk can legitimately emit
    # nothing (stage with no advisory hooks); both are fatal under
    # set -e inside $( ). Count with awk's END block instead: always
    # prints, always exits 0.
    _stage_count="$(printf '%s\n' "$_stage_hooks" | awk 'END {print NR}')"
    _stage_advisory="$(printf '%s\n' "$_hooks" | awk -F'\034' -v s="$_stage" '$4 == s && $10 == "true"' | awk 'END {print NR}')"
    _tmp="$(mktemp)"
    {
        printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail'
        printf '%s\n' '# AUTO-GENERATED by /opt/workspace-ci/scripts/generate-hooks'
        printf '_ROOT="$(git rev-parse --show-toplevel)"\ncd "$_ROOT"\n'
        printf '%s\n' '[[ -f /opt/workspace-ci/lib/ci.sh ]] || { printf "WORKSPACE-CI deployment unavailable\\n" >&2; exit 1; }'
        printf '%s\n' ''
        printf '%s\n' '# === trust boundary: caller input never selects code, policy, or scan root ==='
        printf '%s\n' '# REQ-HOOK-TRUST-BOUNDARY sections 3 and 4.'
        printf '%s\n' 'for _tb_var in ${!CI_CONFIG_PATH_@} ${!CI_CONFIG_OVERRIDES@} ${!CI_GUARD_CONFIG_OVERRIDES@} \'
        printf '%s\n' '    CI_GUARD_CONFIG_DIR WORKSPACE_CI_CONFIG_ROOT WORKSPACE_GUARD_CONFIG_ROOT \'
        printf '%s\n' '    WORKSPACE_GUARD_CONFIG_OVERRIDES PYTHONPATH CI_CONFIG_DIR CI_PROJECT_ROOT \'
        printf '%s\n' '    CI_LIB_DIR CI_BOOT_DIR CI_SCAN_ROOT \'
        printf '%s\n' '    GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_PREFIX \'
        printf '%s\n' '    GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE \'
        printf '%s\n' '    GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM; do'
        printf '%s\n' '    unset "$_tb_var"'
        printf '%s\n' 'done'
        printf '%s\n' 'unset _tb_var'
        printf '%s\n' 'source /opt/workspace-ci/lib/ci.sh'
        printf '%s\n' 'export CI_PROJECT_ROOT=/opt/workspace-ci'
        printf '%s\n' 'export CI_LIB_DIR=/opt/workspace-ci/lib'
        printf '%s\n' 'export CI_CONFIG_DIR=/opt/workspace-ci/config'
        printf '%s\n' 'export CI_BOOT_DIR=/opt/workspace-ci/.boot-linux'
        printf '%s\n' 'export CI_SCAN_ROOT="$_ROOT"'
        printf '%s\n' ''
        printf '%s\n' '# A hook must never execute writable-checkout code with root authority.'
        printf '%s\n' '# Re-exec as the repository owner so any source-development command'
        printf '%s\n' '# (make lint/type-check/check-push) runs unprivileged.'
        printf '%s\n' 'if [[ $EUID -eq 0 ]]; then'
        printf '%s\n' '    _hook_owner="$(stat -c %U "$_ROOT")"'
        printf '%s\n' '    [[ "$_hook_owner" != root ]] || { printf "hook: repository owner is root\\n" >&2; exit 1; }'
        printf '%s\n' '    _hook_home="$(getent passwd "$_hook_owner" | cut -d: -f6)"'
        printf '%s\n' '    exec /usr/sbin/runuser -u "$_hook_owner" -- env HOME="$_hook_home" "$BASH" "$0" "$@"'
        printf '%s\n' 'fi'
        printf '%s\n' ''
        printf '%s\n' '# === quality_exceptions.yaml preflight (mandatory) ==='
        printf '%s\n' 'if [[ ! -f "$_ROOT/quality_exceptions.yaml" ]]; then'
        printf '%s\n' '    ci_fail "quality_exceptions.yaml missing at $_ROOT"'
        printf '%s\n' '    echo "  Fix: copy /opt/workspace-ci/templates/quality_exceptions.template.yaml"'
        printf '%s\n' '    echo "       to $_ROOT/quality_exceptions.yaml and replace __PROJECT_NAME__."'
        printf '%s\n' '    exit 1'
        printf '%s\n' 'fi'
        printf '%s\n' ''
        printf '%s\n' '# === exemption-file compliance (mandatory) ==='
        printf '%s\n' '# CI-BUILTIN-EXEMPTION-COMPLIANCE'
        printf '%s\n' '_exemptions_lib="/opt/workspace-ci/lib/ci_exemptions.sh"'
        printf '%s\n' '_exemptions_manifest="/opt/workspace-ci/config/exemption_files.yaml"'
        printf '%s\n' 'if [[ ! -f "$_exemptions_lib" || ! -f "$_exemptions_manifest" ]]; then'
        printf '%s\n' '    ci_fail "CI exemption infrastructure missing (lib/ci_exemptions.sh or config/exemption_files.yaml)"'
        printf '%s\n' '    exit 1'
        printf '%s\n' 'fi'
        printf '%s\n' 'if ! source "$_exemptions_lib"; then'
        printf '%s\n' '    ci_fail "failed to source $_exemptions_lib"'
        printf '%s\n' '    exit 1'
        printf '%s\n' 'fi'
        printf '%s\n' '_exemption_fail=0'
        printf '%s\n' '_exemption_paths="$(sed -n "s/^  - path: //p" "$_exemptions_manifest")"'
        printf '%s\n' 'for _rel in $_exemption_paths; do'
        printf '%s\n' '    _exemption_state="$(ci_exemption_file_state "$_ROOT/$_rel")"'
        printf '%s\n' '    if [[ "$_exemption_state" != "ok" ]]; then'
        printf '%s\n' '        ci_fail "exemption file not compliant: $_rel (state: $_exemption_state)"'
        printf '%s\n' '        _exemption_fail=1'
        printf '%s\n' '    fi'
        printf '%s\n' 'done'
        printf '%s\n' 'if [[ "$_exemption_fail" -eq 1 ]]; then'
        printf '%s\n' '    echo "  Fix: files must be root-owned regular files; edit via the root-gated yaml editor"'
        printf '%s\n' '    exit 1'
        printf '%s\n' 'fi'
        printf '%s\n' ''
        printf '%s\n' '# === CI catalog provenance (CI repo only, mandatory) ==='
        printf '%s\n' '# CI-BUILTIN-CATALOG-PROVENANCE'
        printf '%s\n' 'if [[ -f "$_ROOT/scripts/generate-hooks" && -d "$_ROOT/config" ]]; then'
        printf '%s\n' '    _catalog_fail=0'
        printf '%s\n' '    for _catalog in "$_ROOT"/config/*.yaml; do'
        printf '%s\n' '        [[ -e "$_catalog" ]] || continue'
        printf '%s\n' '        _catalog_state="$(ci_exemption_file_state "$_catalog")"'
        printf '%s\n' '        if [[ "$_catalog_state" != "ok" ]]; then'
        printf '%s\n' '            ci_fail "CI catalog not compliant: ${_catalog#$_ROOT/} (state: $_catalog_state)"'
        printf '%s\n' '            _catalog_fail=1'
        printf '%s\n' '        fi'
        printf '%s\n' '    done'
        printf '%s\n' '    if [[ "$_catalog_fail" -eq 1 ]]; then'
        printf '%s\n' '        echo "  Fix: config/*.yaml must be root-owned regular files; edit via the root-gated yaml editor"'
        printf '%s\n' '        exit 1'
        printf '%s\n' '    fi'
        printf '%s\n' 'fi'
        while IFS=$'\034' read -r h_id h_name h_entry h_stage h_pass h_always h_files h_exclude h_types h_advisory; do
            [[ -n "$h_id" ]] || continue
            [[ -n "$h_entry" ]] || { ci_fail "Hook '$h_id' has empty entry"; exit 1; }
            h_cmd="$h_entry"
            h_cmd="${h_cmd//uv run python -m ci./\/opt\/workspace-ci\/.boot-linux\/bin\/uv run --project \/opt\/workspace-ci --no-sync python -P -m ci.}"
            printf '# === Hook: %s ===\n' "$h_id"
            printf 'ci_info "Running: %s..."\n' "$h_name"
            if [[ "$h_advisory" == "true" ]]; then
                # Advisory hooks report findings but never fail the gate:
                # the exit status is captured explicitly (sanctioned
                # pattern) and surfaced with ci_info, never enforced.
                printf '_advisory_rc=0\n'
                printf '%s || _advisory_rc=$?\n' "$h_cmd"
                printf 'if [[ "$_advisory_rc" -ne 0 ]]; then ci_info "ADVISORY (non-blocking): %s exited $_advisory_rc; reported, not enforced"; fi\n' "$h_name"
            elif [[ "$_stage" == commit-msg ]]; then
                printf '%s "$1" || { ci_fail "%s"; exit 1; }\n' "$h_cmd" "$h_name"
            else
                printf '%s || { ci_fail "%s"; exit 1; }\n' "$h_cmd" "$h_name"
            fi
        done <<< "$_stage_hooks"
    } > "$_tmp"
    if [[ "$_dry_run" -eq 1 ]]; then
        cat "$_tmp"
        rm -f "$_tmp"
        ci_info "DRY-RUN: $_stage would write $_stage_count hooks ($_stage_advisory advisory)"
    else
        mv "$_tmp" "$_output_dir/$_stage"
        chmod 0755 "$_output_dir/$_stage"
        ci_pass "$_stage: $_stage_count hooks written ($_stage_advisory advisory)"
        _written_stages+=("$_stage")
    fi
done
if [[ "$_dry_run" -eq 1 ]]; then
    ci_pass "dry run complete; no files written"
elif [[ "${#_written_stages[@]}" -gt 0 ]]; then
    ci_pass "SUCCESS: ${#_written_stages[@]} hook files written to $_output_dir"
    ci_info "activate with: make install-hooks"
else
    ci_fail "no stages rendered from $_config"
    exit 1
fi

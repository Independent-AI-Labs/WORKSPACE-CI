#!/usr/bin/env bash
# generate-hooks: Generate native git hooks from .pre-commit-config.yaml.
set -euo pipefail

_SELF="${BASH_SOURCE[0]:-$0}"
case "$_SELF" in /proc/self/fd/*) _SELF="${SHG_SCRIPT_PATH:-$_SELF}" ;; esac
_SCRIPT_DIR="$(cd "$(dirname "$_SELF")" && pwd)"
_CI_ROOT="$(cd "$_SCRIPT_DIR/.." && pwd)"
if ! source "$_CI_ROOT/lib/ci.sh"; then
    printf 'generate-hooks: failed to load lib/ci.sh\n' >&2
    exit 1
fi
if ! source "$_CI_ROOT/lib/checks_quality.sh"; then
    printf 'generate-hooks: failed to load lib/checks_quality.sh\n' >&2
    exit 1
fi

_config=".pre-commit-config.yaml"
_output_dir=""
_dry_run=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --config) _config="$2"; shift 2 ;;
        --output-dir) _output_dir="$2"; shift 2 ;;
        --dry-run) _dry_run=1; shift ;;
        *) ci_fail "Unknown option: $1"; exit 1 ;;
    esac
done
[[ -f "$_config" ]] || { ci_fail "Config not found: $_config"; exit 1; }
[[ -n "$_output_dir" ]] || _output_dir="$(git rev-parse --git-dir)/hooks"
mkdir -p "$_output_dir"

_hooks="$(awk -f "$_CI_ROOT/lib/parse_precommit_config.awk" "$_config")"
[[ -n "$_hooks" ]] || exit 0

for _stage in pre-commit commit-msg pre-push; do
    _stage_hooks="$(printf '%s\n' "$_hooks" | awk -F'\034' -v s="$_stage" '$4 == s')"
    [[ -n "$_stage_hooks" ]] || continue
    _tmp="$(mktemp)"
    {
        printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail'
        printf '%s\n' '# AUTO-GENERATED by /opt/workspace-ci/scripts/generate-hooks'
        printf '_ROOT="$(git rev-parse --show-toplevel)"\ncd "$_ROOT"\n'
        printf '%s\n' '[[ -f /opt/workspace-ci/lib/ci.sh ]] || { printf "WORKSPACE-CI deployment unavailable\\n" >&2; exit 1; }'
        printf '%s\n' 'source /opt/workspace-ci/lib/ci.sh'
        while IFS=$'\034' read -r h_id h_name h_entry h_stage h_pass h_always h_files h_exclude h_args h_types; do
            [[ -n "$h_id" ]] || continue
            [[ -n "$h_entry" ]] || { ci_fail "Hook '$h_id' has empty entry"; exit 1; }
            h_cmd="${h_entry//bash -c/\"\$BASH\" -c}"
            h_cmd="${h_cmd//uv run python -m ci./\/opt\/workspace-ci\/.venv\/bin\/python -m ci.}"
            [[ -n "$h_args" ]] && h_cmd="$h_cmd $h_args"
            printf 'ci_info "Running: %s..."\n' "$h_name"
            if [[ "$_stage" == commit-msg ]]; then
                printf '%s "$1" || { ci_fail "%s"; exit 1; }\n' "$h_cmd" "$h_name"
            else
                printf '%s || { ci_fail "%s"; exit 1; }\n' "$h_cmd" "$h_name"
            fi
        done <<< "$_stage_hooks"
    } > "$_tmp"
    if [[ "$_dry_run" -eq 1 ]]; then
        cat "$_tmp"
        rm -f "$_tmp"
    else
        mv "$_tmp" "$_output_dir/$_stage"
        chmod 0755 "$_output_dir/$_stage"
    fi
done

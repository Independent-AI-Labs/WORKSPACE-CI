[Unit]
Description=Cloudflare Tunnel for workspace-ci Wiki (prod)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ project_root }}
{% if tunnel_token | length > 0 %}
ExecStart={{ cloudflared_bin }} tunnel run --token-file {{ tunnel_token_file }}
{% else %}
ExecStart={{ cloudflared_bin }} tunnel --config {{ tunnel_config }} run
{% endif %}
Restart=always
RestartSec=10
SyslogIdentifier=wiki-ci-tunnel

[Install]
WantedBy=default.target

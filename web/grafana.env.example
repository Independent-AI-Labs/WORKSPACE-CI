# Per-instance Grafana configuration. No registry lookup or implicit default: the
# dev proxy and server-side health probe only use these explicit settings.

# Dev Grafana origin the wiki /grafana proxy forwards to. REQUIRED for the dev
# proxy; when unset the proxy and /api/grafana/health return 503.
GRAFANA_DEV_UPSTREAM=http://127.0.0.1:3030

# Public Grafana base for browser embeds. Leave GRAFANA_BASE_URL unset so URLs
# derive from the wiki request host (recommended).
# Only set this for special cases (e.g. remote Grafana):
# GRAFANA_BASE_URL=http://127.0.0.1:3030/grafana

# Server-side health probe override (container DNS). Optional.
# GRAFANA_INTERNAL_HEALTH_URL=http://gw-grafana:3000/api/health

# Home landing at / (catalogue stays at /projects). Omit or set false to show catalogue on /.
WIKI_HOME_LANDING_ENABLED=true

# workspace-ci Wiki production image.
# Build context: workspace projects root (parent of CI/).
#   podman build -f CI/web/Containerfile -t workspace-ci-wiki:0.1.0 <projects-root>
# CI_CONTEXT_DIR names the repo checkout inside the build context (CI or
# WORKSPACE-CI); in-image paths stay /workspace/CI regardless.

ARG CI_CONTEXT_DIR=CI

# -----------------------------------------------------------------------------
# Stage 1: regenerate wiki JSON data from CI sources
# -----------------------------------------------------------------------------
FROM docker.io/library/python:3.13 AS extract

ARG CI_CONTEXT_DIR

RUN set -eux \
    && echo "[wiki-extract] apt-get update" \
    && apt-get update \
    && echo "[wiki-extract] apt-get install packages" \
    && apt-get install -y --no-install-recommends cloc git curl ca-certificates make \
    && echo "[wiki-extract] apt cleanup" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/CI

COPY ${CI_CONTEXT_DIR}/pyproject.toml CI/uv.lock ./
COPY ${CI_CONTEXT_DIR}/ci ./ci
COPY ${CI_CONTEXT_DIR}/lib ./lib
COPY ${CI_CONTEXT_DIR}/scripts ./scripts
COPY ${CI_CONTEXT_DIR}/config ./config
COPY ${CI_CONTEXT_DIR}/res ./res
COPY ${CI_CONTEXT_DIR}/Makefile ./
COPY ${CI_CONTEXT_DIR}/web/src/data ./web/src/data

ENV CI_WEB_DATA_DIR=/workspace/CI/web/src/data
ENV CI_CONFIG_DIR=/workspace/CI/config
ENV CI_PROJECT_ROOT=/workspace/CI
ENV UV_VERSION=0.11.23
ENV PATH=/workspace/CI/.boot-linux/bin:/usr/local/bin:/usr/bin:/bin
# code-stats.json is copied from the repo above (refreshed on the host by
# wiki-prod-build); the extract stage has no sibling git repos, so regenerate
# hook/script/swallow data only, via the same make targets the host uses.
RUN set -eux \
    && echo "[wiki-extract] bootstrap uv" \
    && bash scripts/bootstrap-uv \
    && echo "[wiki-extract] uv sync" \
    && uv sync --frozen \
    && echo "[wiki-extract] extract wiki data via make targets" \
    && make extract-hook-sources extract-script-sources extract-swallow-source \
    && echo "[wiki-extract] done"

# -----------------------------------------------------------------------------
# Stage 2: build Next.js standalone bundle
# -----------------------------------------------------------------------------
FROM docker.io/library/node:24.19.0 AS build

ARG CI_CONTEXT_DIR

ENV NODE_OPTIONS=--max-old-space-size=4096
ENV NEXT_TELEMETRY_DISABLED=1
ENV WORKSPACE_PROJECTS_ROOT=/workspace
ENV CHROME_BIN=/usr/bin/chromium

RUN set -eux \
    && echo "[wiki-build] apt-get update" \
    && apt-get update \
    && echo "[wiki-build] install chromium + poppler for prebuild" \
    && apt-get install -y --no-install-recommends chromium poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY WORKSPACE-VM/README.md WORKSPACE-VM/Makefile WORKSPACE-VM/project.yaml ./WORKSPACE-VM/
COPY WORKSPACE-VM/res ./WORKSPACE-VM/res
COPY WORKSPACE-VM/.git/config ./WORKSPACE-VM/.git/config
COPY WORKSPACE-GUARD/config ./WORKSPACE-GUARD/config
COPY WORKSPACE-GUARD/README.md WORKSPACE-GUARD/Makefile WORKSPACE-GUARD/project.yaml ./WORKSPACE-GUARD/
COPY WORKSPACE-GUARD/res ./WORKSPACE-GUARD/res
COPY WORKSPACE-GUARD/.git/config ./WORKSPACE-GUARD/.git/config
COPY WORKSPACE-GATEWAY/README.md WORKSPACE-GATEWAY/Makefile WORKSPACE-GATEWAY/project.yaml ./WORKSPACE-GATEWAY/
COPY WORKSPACE-GATEWAY/res ./WORKSPACE-GATEWAY/res
COPY WORKSPACE-GATEWAY/.git/config ./WORKSPACE-GATEWAY/.git/config
COPY WORKSPACE-GATEWAY/conf/grafana/dashboards ./WORKSPACE-GATEWAY/conf/grafana/dashboards
COPY WORKSPACE-WEB-CONTENT/ ./WORKSPACE-WEB-CONTENT/
COPY ${CI_CONTEXT_DIR}/README.md CI/Makefile ${CI_CONTEXT_DIR}/project.yaml ./CI/
COPY ${CI_CONTEXT_DIR}/res ./CI/res
COPY ${CI_CONTEXT_DIR}/config ./CI/config
COPY ${CI_CONTEXT_DIR}/docs ./CI/docs
COPY ${CI_CONTEXT_DIR}/scripts ./CI/scripts
COPY ${CI_CONTEXT_DIR}/web ./CI/web
COPY ${CI_CONTEXT_DIR}/package.json ${CI_CONTEXT_DIR}/package-lock.json ./CI/
COPY ${CI_CONTEXT_DIR}/web-components ./CI/web-components
COPY ${CI_CONTEXT_DIR}/README.md WORKSPACE-CI/Makefile ${CI_CONTEXT_DIR}/project.yaml ./WORKSPACE-CI/
COPY ${CI_CONTEXT_DIR}/res ./WORKSPACE-CI/res
COPY ${CI_CONTEXT_DIR}/.git/config ./WORKSPACE-CI/.git/config
COPY --from=extract /workspace/CI/web/src/data ./CI/web/src/data

WORKDIR /workspace/CI/web
ENV CI_WIKI_PROD_BUILD=1
ENV WIKI_HOME_LANDING_ENABLED=true
ENV ALLOWED_ORIGINS=""
ENV WIKI_DEV_PORT=4000
RUN set -eux \
    && echo "[wiki-build] checking inputs" \
    && test -f /workspace/CI/README.md \
    && test -f /workspace/WORKSPACE-WEB-CONTENT/landing-posts.yaml \
    && cd /workspace/CI \
    && echo "[wiki-build] npm install (workspace root)" \
    && npm install \
    && cd /workspace/CI/web \
    && echo "[wiki-build] npm run build" \
    && npm run build \
    && echo "[wiki-build] done"

# -----------------------------------------------------------------------------
# Stage 3: minimal runtime
# -----------------------------------------------------------------------------
FROM docker.io/library/node:24.19.0 AS run

ARG CI_CONTEXT_DIR

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV WORKSPACE_PROJECTS_ROOT=/workspace
ENV WORKSPACE_WEB_CONTENT_ROOT=/workspace/WORKSPACE-WEB-CONTENT
ENV CI_WEB_DATA_DIR=/workspace/CI/web/src/data
ENV CI_CONFIG_DIR=/workspace/CI/config
ENV CI_GUARD_CONFIG_DIR=/workspace/WORKSPACE-GUARD/config
ENV WIKI_FEEDBACK_DIR=/workspace/CI/web/data/feedback

WORKDIR /workspace

COPY WORKSPACE-VM/README.md WORKSPACE-VM/Makefile ./WORKSPACE-VM/
COPY WORKSPACE-VM/res ./WORKSPACE-VM/res
COPY WORKSPACE-VM/.git/config ./WORKSPACE-VM/.git/config
COPY WORKSPACE-GUARD/config ./WORKSPACE-GUARD/config
COPY WORKSPACE-GUARD/README.md WORKSPACE-GUARD/Makefile ./WORKSPACE-GUARD/
COPY WORKSPACE-GUARD/res ./WORKSPACE-GUARD/res
COPY WORKSPACE-GUARD/.git/config ./WORKSPACE-GUARD/.git/config
COPY WORKSPACE-GATEWAY/README.md WORKSPACE-GATEWAY/Makefile ./WORKSPACE-GATEWAY/
COPY WORKSPACE-GATEWAY/res ./WORKSPACE-GATEWAY/res
COPY WORKSPACE-GATEWAY/.git/config ./WORKSPACE-GATEWAY/.git/config
COPY WORKSPACE-WEB-CONTENT/ ./WORKSPACE-WEB-CONTENT/
COPY ${CI_CONTEXT_DIR}/README.md CI/Makefile ./CI/
COPY ${CI_CONTEXT_DIR}/res ./CI/res
COPY ${CI_CONTEXT_DIR}/config ./CI/config
COPY ${CI_CONTEXT_DIR}/docs ./CI/docs
COPY ${CI_CONTEXT_DIR}/scripts ./CI/scripts
COPY ${CI_CONTEXT_DIR}/README.md WORKSPACE-CI/Makefile ./WORKSPACE-CI/
COPY ${CI_CONTEXT_DIR}/res ./WORKSPACE-CI/res
COPY ${CI_CONTEXT_DIR}/.git/config ./WORKSPACE-CI/.git/config

WORKDIR /workspace/CI/web

# Standalone output mirrors the npm-workspaces tracing root (/workspace/CI):
# server.js lives at web/server.js with hoisted node_modules alongside it.
COPY --from=build /workspace/CI/web/public ./web/public
COPY --from=build /workspace/CI/web/.next/standalone ./
COPY --from=build /workspace/CI/web/.next/static ./web/.next/static
COPY --from=build /workspace/CI/web/branding.yaml ./branding.yaml
COPY --from=build /workspace/CI/web/content ./content
COPY --from=build /workspace/CI/web/src/data ./src/data

RUN mkdir -p data/feedback

EXPOSE 3000
CMD ["node", "web/server.js"]

# Makefile.consumer: template for scaffold-ci generated Makefiles.
# Placeholders substituted by scaffold-ci at generation time.
#
# AUTO-GENERATED by __REL_CI__/scripts/scaffold-ci [__TIMESTAMP__]
# Source: ci-profile.yaml | tier=__TIER__ | languages=__LANGUAGES__
# Re-generate (safe, pre-commit only): make -C __REL_CI__ scaffold-ci CONSUMER=. --force-precommit --yes
# WARNING: --force-all overwrites Makefile + config/*.yaml. --force is removed;
#          use --force-precommit | --force-makefile | --force-configs | --force-all.
#          --force-makefile REFUSES if this Makefile has been customised.
#
# Language-specific targets (lint, type-check, test, check-push) are
# intentional vacuous passes. Fill them in per your project's stack.

# The guarded /bin/bash is the shell for every recipe, root included.
# Repository provisioning never uses the sealed root-shell escape
# (policy: shell-guard interpreter coverage); root recipes reach
# reinstall-hooks through the guarded shell exactly as the canonical
# WORKSPACE-CI Makefile does.
SHELL := /bin/bash
SCRIPT_BASH := bash
.DEFAULT_GOAL := help

# Repo root from this Makefile's own path, not `git rev-parse`: root/sudo
# hits safe.directory, so a git probe would fail for root callers.
_CONSUMER_MK := $(abspath $(lastword $(MAKEFILE_LIST)))
REPO_ROOT := $(patsubst %/,%,$(dir $(_CONSUMER_MK)))
CI_DIR := $(if $(filter /%,__REL_CI__),__REL_CI__,$(abspath $(REPO_ROOT)/__REL_CI__))

-include $(CI_DIR)/lib/makefile_contract.mk

# =============================================================================
# Help
# =============================================================================
.PHONY: help
help: ## Show this help
	grep -hE '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}'

# =============================================================================
# Setup
# =============================================================================
.PHONY: preflight init install install-ci install-deps install-hooks sync
preflight: ## Verify environment
	test -d "$(CI_DIR)" || { echo "ERROR: CI directory not found at $(CI_DIR)" >&2; exit 1; }
	test -f "$(CI_DIR)/scripts/reinstall-hooks" || { echo "ERROR: reinstall-hooks missing" >&2; exit 1; }
	echo "Preflight OK"

init: ## Install system-level dependencies
	echo "TODO: implement per-project system dependencies."
	:

install: install-deps ## Full install: deps (hooks install separately, root-only: sudo make install-hooks)
	:

install-ci: install-deps ## CI install: deps only, no hooks
	:

install-deps: ## Install project dependencies
	echo "TODO: implement per-project dependency install."
	:

install-hooks: ## Install native git hooks (root-only: root-owned, immutable)
	$(SCRIPT_BASH) $(CI_DIR)/scripts/reinstall-hooks

sync: install-deps ## Sync deps (hooks install separately, root-only: sudo make install-hooks)
	:

# =============================================================================
# Quality Gates
# =============================================================================
.PHONY: check lint type-check test check-push clean clean-precommit

check: lint type-check test ## Run all quality gates
	echo "TODO: wire lint+type-check+test implementations."

lint: ## Lint
	:

type-check: ## Type-check
	:

test: ## Test
	:

check-push: ## Pre-push quality gate
	:

# =============================================================================
# Cleanup
# =============================================================================
clean: ## Remove build artifacts
	echo "TODO: implement per-project clean."
	:

clean-precommit: ## Remove pre-commit framework traces
	$(SCRIPT_BASH) $(CI_DIR)/scripts/cleanup-precommit
